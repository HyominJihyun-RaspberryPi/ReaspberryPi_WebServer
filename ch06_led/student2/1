<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>ON / OFF State Switcher</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;600;700&display=swap" rel="stylesheet">
    <style>
        body {
            font-family: 'Inter', sans-serif;
            background: radial-gradient(circle at center, #1e293b 0%, #0f172a 100%);
        }
        
        /* Glow animations and transitions */
        .glow-on {
            filter: drop-shadow(0 0 25px rgba(59, 130, 246, 0.8)) drop-shadow(0 0 50px rgba(16, 185, 129, 0.4));
            transition: filter 0.5s ease-in-out, transform 0.3s ease;
        }

        .glow-off {
            filter: drop-shadow(0 0 10px rgba(0, 0, 0, 0.5));
            transition: filter 0.5s ease-in-out, transform 0.3s ease;
        }

        .status-badge {
            transition: all 0.3s ease;
        }
    </style>
</head>
<body class="min-h-screen text-slate-100 flex flex-col items-center justify-center p-4 selection:bg-blue-500 selection:text-white">

    <div class="w-full max-w-md bg-slate-800/60 backdrop-blur-xl border border-slate-700/60 rounded-3xl p-8 shadow-2xl flex flex-col items-center text-center">
        
        <!-- Header Title -->
        <h1 class="text-2xl font-bold tracking-tight mb-2 text-slate-200">Device Controller</h1>
        <p class="text-xs text-slate-400 mb-8">Click the buttons below to switch state</p>

        <!-- Center Image Display Box -->
        <div class="relative w-64 h-64 flex items-center justify-center bg-slate-900/80 rounded-2xl border border-slate-700/50 p-6 mb-8 shadow-inner overflow-hidden">
            <!-- Background Light Ambient Effect -->
            <div id="ambientLight" class="absolute inset-0 bg-blue-500/0 rounded-2xl transition-all duration-500"></div>

            <!-- Central ON/OFF Display SVG Graphics -->
            <!-- ON Image Graphic -->
            <svg id="imgOn" class="w-40 h-40 glow-on hidden transition-all duration-500 transform scale-100 z-10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                <circle cx="12" cy="12" r="9" class="stroke-emerald-400" fill="#10b981" fill-opacity="0.15" />
                <path d="M12 7v10" stroke="#34d399" stroke-width="2.5" stroke-linecap="round" />
                <circle cx="12" cy="12" r="4" class="stroke-emerald-300 animate-pulse" stroke-width="1.5" />
            </svg>

            <!-- OFF Image Graphic -->
            <svg id="imgOff" class="w-40 h-40 glow-off transition-all duration-500 transform scale-100 z-10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                <circle cx="12" cy="12" r="9" class="stroke-slate-600" fill="#1e293b" fill-opacity="0.5" />
                <path d="M12 8v4" stroke="#64748b" stroke-width="2.5" stroke-linecap="round" />
                <circle cx="12" cy="16" r="1" fill="#64748b" />
            </svg>
        </div>

        <!-- Status Indicator Pill -->
        <div id="statusPill" class="status-badge flex items-center gap-2 px-4 py-1.5 rounded-full text-xs font-semibold bg-slate-700/60 text-slate-400 mb-8 border border-slate-600/40">
            <span id="statusDot" class="w-2 h-2 rounded-full bg-slate-500"></span>
            <span id="statusText">State: OFF</span>
        </div>

        <!-- ON / OFF Action Buttons -->
        <div class="grid grid-cols-2 gap-4 w-full">
            <!-- ON Button -->
            <button id="btnOn" onclick="turnOn()" class="group relative px-6 py-3.5 rounded-xl font-bold text-sm tracking-wide transition-all duration-200 bg-slate-700 hover:bg-emerald-600 text-emerald-400 hover:text-white shadow-lg hover:shadow-emerald-500/20 border border-emerald-500/30 hover:border-emerald-500 active:scale-95">
                <span class="flex items-center justify-center gap-2">
                    <svg class="w-4 h-4 fill-current" viewBox="0 0 20 20"><path d="M10 18a8 8 0 100-16 8 8 0 000 16zm1-11a1 1 0 10-2 0v4a1 1 0 102 0V7z"/></svg>
                    ON
                </span>
            </button>

            <!-- OFF Button -->
            <button id="btnOff" onclick="turnOff()" class="group relative px-6 py-3.5 rounded-xl font-bold text-sm tracking-wide transition-all duration-200 bg-slate-700 hover:bg-rose-600 text-rose-400 hover:text-white shadow-lg hover:shadow-rose-500/20 border border-rose-500/30 hover:border-rose-500 active:scale-95">
                <span class="flex items-center justify-center gap-2">
                    <svg class="w-4 h-4 fill-current" viewBox="0 0 20 20"><path d="M10 18a8 8 0 100-16 8 8 0 000 16zM9 9a1 1 0 012 0v4a1 1 0 11-2 0V9z"/></svg>
                    OFF
                </span>
            </button>
        </div>

    </div>

    <script>
        const imgOn = document.getElementById('imgOn');
        const imgOff = document.getElementById('imgOff');
        const statusText = document.getElementById('statusText');
        const statusDot = document.getElementById('statusDot');
        const statusPill = document.getElementById('statusPill');
        const ambientLight = document.getElementById('ambientLight');
        const btnOn = document.getElementById('btnOn');
        const btnOff = document.getElementById('btnOff');

        function turnOn() {
            // Show ON image, hide OFF image
            imgOn.classList.remove('hidden');
            imgOff.classList.add('hidden');

            // Ambient background glow
            ambientLight.className = "absolute inset-0 bg-emerald-500/10 rounded-2xl transition-all duration-500";

            // Status Pill updates
            statusText.innerText = "State: ON";
            statusDot.className = "w-2 h-2 rounded-full bg-emerald-400 animate-ping";
            statusPill.className = "status-badge flex items-center gap-2 px-4 py-1.5 rounded-full text-xs font-semibold bg-emerald-500/10 text-emerald-400 mb-8 border border-emerald-500/30 shadow-sm shadow-emerald-500/20";

            // Highlight Active Button
            btnOn.classList.add('bg-emerald-600', 'text-white', 'ring-2', 'ring-emerald-400');
            btnOff.classList.remove('bg-rose-600', 'text-white', 'ring-2', 'ring-rose-400');
        }

        function turnOff() {
            // Show OFF image, hide ON image
            imgOff.classList.remove('hidden');
            imgOn.classList.add('hidden');

            // Ambient background reset
            ambientLight.className = "absolute inset-0 bg-blue-500/0 rounded-2xl transition-all duration-500";

            // Status Pill updates
            statusText.innerText = "State: OFF";
            statusDot.className = "w-2 h-2 rounded-full bg-slate-500";
            statusPill.className = "status-badge flex items-center gap-2 px-4 py-1.5 rounded-full text-xs font-semibold bg-slate-700/60 text-slate-400 mb-8 border border-slate-600/40";

            // Highlight Active Button
            btnOff.classList.add('bg-rose-600', 'text-white', 'ring-2', 'ring-rose-400');
            btnOn.classList.remove('bg-emerald-600', 'text-white', 'ring-2', 'ring-emerald-400');
        }

        // Initialize default state
        turnOff();
    </script>
</body>
</html>
